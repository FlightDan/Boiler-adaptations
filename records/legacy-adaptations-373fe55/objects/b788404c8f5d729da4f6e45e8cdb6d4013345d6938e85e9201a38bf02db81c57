+    async fn set_proxy(&mut self, proxy: Option<(OwnedBusName, OwnedObjectPath)>) -> Result<()> {
+        let signal_task = if let Some((destination, path)) = &proxy {
+            // Raw signals do not populate a GetAll cache, which can permanently
+            // retain an initial hardware error and stop property change streams.
+            let properties = fdo::PropertiesProxy::builder(&self.system)
+                .destination(destination.clone())?
+                .path(path.clone())?
+                .cache_properties(zbus::proxy::CacheProperties::No)
+                .build()
+                .await?;
+            let mut signals = properties.receive_properties_changed().await?;
+            let session = self.session.clone();
+            Some(tokio::spawn(async move {
+                while let Some(signal) = signals.next().await {
+                    let args = match signal.args() {
+                        Ok(args) => args,
+                        Err(error) => {
+                            warn!("Invalid remote TDP PropertiesChanged signal: {error}");
+                            continue;
+                        }
+                    };
+                    if args.interface_name != "com.steampowered.SteamOSManager1.TdpLimit1"
+                        || (!args.changed_properties.contains_key("TdpLimit")
+                            && !args.invalidated_properties.contains(&"TdpLimit"))
+                    {
+                        continue;
+                    }
+                    let object_server = session.object_server();
+                    if let Ok(interface) = object_server.interface::<_, TdpLimit1>(MANAGER_PATH).await {
+                        let ctx = interface.signal_emitter();
+                        if let Err(error) = interface.get().await.tdp_limit_invalidate(ctx).await {
+                            error!("Failed to invalidate remote TDP limit: {error}");
+                        }
+                    }
+                }
+            }))
+        } else {
+            None
+        };
+        if let Err(error) = self.manager.set_proxy(proxy).await {
+            if let Some(task) = signal_task {
+                task.abort();
+            }
+            return Err(error);
+        }
+        if let Some(task) = self.signal_task.take() {
+            task.abort();
+        }
+        self.signal_task = signal_task;
         Ok(())
     }
 
