[Unit]
Description=OXP3 volume keys
[Service]
ExecCondition=/usr/bin/python3 -I -B /usr/local/lib/oxp3-integration/integration_runtime.py guard
Type=notify
NotifyAccess=main
TimeoutStartSec=30
ExecStart=/usr/bin/python3 -I -B /var/lib/oxp3-runtime-hardened/volume.py
Restart=on-failure
[Install]
WantedBy=multi-user.target
