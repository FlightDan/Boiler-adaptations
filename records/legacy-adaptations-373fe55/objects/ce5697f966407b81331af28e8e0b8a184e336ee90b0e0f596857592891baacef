--- /dev/null
+++ b/binder/kernel_call.S
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Retpoline sequence follows Linux arch/x86/lib/retpoline.S. */
+#include <linux/linkage.h>
+#include <asm/nospec-branch.h>
+#include <asm/unwind_hints.h>
+.text
+SYM_CODE_START(binder_kernel_call_thunk)
+        UNWIND_HINT_UNDEFINED
+        ANNOTATE_NOENDBR
+        ANNOTATE_INTRA_FUNCTION_CALL
+        call .Lbinder_kernel_target
+        int3
+.Lbinder_kernel_target:
+        mov %rax, (%rsp)
+        UNWIND_HINT_FUNC
+        RET
+SYM_CODE_END(binder_kernel_call_thunk)
