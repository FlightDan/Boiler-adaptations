+/* A local, annotated retpoline calls the audited kernel dependency targets.
+ * It supports the x86-64 kernel ABI's first four integer/pointer arguments.
+ * No global IBT setting or kernel text is changed.
+ */
+static __always_inline unsigned long binder_kernel_call4(unsigned long target,
+        unsigned long arg1, unsigned long arg2,
+        unsigned long arg3, unsigned long arg4)
+{
+        asm volatile("call binder_kernel_call_thunk\n"
+                : "+a" (target), "+D" (arg1), "+S" (arg2),
+                  "+d" (arg3), "+c" (arg4), ASM_CALL_CONSTRAINT
+                :
+                : "r8", "r9", "r10", "r11", "memory", "cc");
+        return target;
+}
+#define BINDER_CALL1(fn,a) binder_kernel_call4((unsigned long)(fn),(unsigned long)(a),0,0,0)
+#define BINDER_CALL2(fn,a,b) binder_kernel_call4((unsigned long)(fn),(unsigned long)(a),(unsigned long)(b),0,0)
+#define BINDER_CALL3(fn,a,b,c) binder_kernel_call4((unsigned long)(fn),(unsigned long)(a),(unsigned long)(b),(unsigned long)(c),0)
+#define BINDER_CALL4(fn,a,b,c,d) binder_kernel_call4((unsigned long)(fn),(unsigned long)(a),(unsigned long)(b),(unsigned long)(c),(unsigned long)(d))
+
