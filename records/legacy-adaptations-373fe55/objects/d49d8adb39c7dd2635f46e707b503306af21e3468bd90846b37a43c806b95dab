"""Check the standalone source snapshot without a Boiler checkout or network."""
import hashlib
import importlib.util
from pathlib import Path
import sys

ROOT=Path(__file__).resolve().parents[1]
PARSER_LOCK_SHA='22afc358ad90c2ef1eed6e846cd45db1c1dfc59c52f33e318b8a13c37de921a5'

def sha(raw): return hashlib.sha256(raw).hexdigest()
def filesystem(path):
    value=str(path.absolute())
    if sys.platform=='win32' and not value.startswith('\\\\?\\'):
        value='\\\\?\\UNC\\'+value[2:] if value.startswith('\\\\') else '\\\\?\\'+value
    return Path(value)

ROOT=filesystem(ROOT)
def resolved(path):
    value=str(path.resolve())
    if sys.platform=='win32':
        if value.startswith('\\\\?\\UNC\\'):value='\\\\'+value[8:]
        elif value.startswith('\\\\?\\'):value=value[4:]
    return Path(value)

def member(name):
    if not isinstance(name,str) or not name or '\\' in name or ':' in name:
        raise ValueError('Unsafe member path')
    path=ROOT
    for part in name.split('/'):
        if part in ('','.','..') or part.endswith((' ','.')):raise ValueError('Unsafe path segment')
        path=path/part
        if path.is_symlink() or getattr(path,'is_junction',lambda:False)():raise ValueError('Linked source member')
    if not resolved(path).is_relative_to(resolved(ROOT)):raise ValueError('Escaping source member')
    return path

def parser():
    # Pin the bootstrap source package before executing any vendored code.
    # File digests are embedded in this small loader, not obtained from its own parser.
    lock=member('locks/toon-parser.toon').read_bytes()
    if sha(lock)!=PARSER_LOCK_SHA:raise ValueError('Parser lock differs')
    sources=BOOTSTRAP
    for name,expected in sources.items():
        if sha(member('vendor/'+name).read_bytes())!=expected:raise ValueError('Parser source differs: '+name)
    path=member('vendor/toon_format/__init__.py')
    spec=importlib.util.spec_from_file_location('toon_format',path,submodule_search_locations=[str(path.parent)])
    module=importlib.util.module_from_spec(spec);sys.modules['toon_format']=module;spec.loader.exec_module(module)
    decoded=module.loads(lock.decode(),strict=True)
    for row in decoded['files']:
        raw=member('vendor/'+row['path']).read_bytes()
        if len(raw)!=row['size'] or sha(raw)!=row['sha256']:raise ValueError('Parser member differs')
    return module

BOOTSTRAP = {'toon_format/__init__.py': '5b6550985ffe3b2e1178087ec442ce4f5a9f67a5e3779d2e82f000e1946d864f', 'toon_format/_api.py': '3eedb3fb29a7c3b1d5dad2814154f59391bb7120f19310eff36bf7bb09b6b55d', 'toon_format/_decoder.py': '20800ade21b98e5699f4e849ab1ace39c8649f4ce41edefce26248de7228eda3', 'toon_format/_encoder.py': '39be8b180e4991cc02fba743707151485fac87e2b8350296c67f1ed7214b50bd', 'toon_format/_errors.py': '8a2730b09fb67e844db45462ba875c732eae73311b8110a2c91e72bc6c9aed27', 'toon_format/_text.py': 'b6e1fc249ee473be80768d608b63cef193ff609c33e6623af5db301960b467cd', 'toon_format/pydantic.py': 'f44b93401a26b417d9f3b60da9dc84e5af5bb8999116fe5743278959a86f9666'}

def check():
    if not BOOTSTRAP:raise ValueError('Missing parser bootstrap inventory')
    toon=parser()
    if list(ROOT.rglob('*.json')):raise ValueError('JSON file in TOON source repository')
    doc=toon.loads(member('locks/public-baseline.toon').read_text(encoding='utf-8'),strict=True)
    if doc['source']['commit']!='72f864e0498c10366493c74608c5ffed62cc99ca':raise ValueError('Unexpected CPU public baseline')
    names=set()
    for row in doc['files']:
        if row['path'] in names:raise ValueError('Duplicate baseline member')
        names.add(row['path']);raw=member(row['path']).read_bytes()
        if len(raw)!=row['size'] or sha(raw)!=row['sha256']:raise ValueError('Baseline member differs: '+row['path'])
        if row['conversion']=='json-to-toon-semantic-v1':toon.loads(raw.decode(),strict=True)
        elif row['conversion']!='identity' or sha(raw)!=row['original_sha256']:raise ValueError('Unexpected conversion')
    actual={p.relative_to(ROOT).as_posix() for p in member('baseline').rglob('*') if p.is_file()}
    if actual!=names:raise ValueError('Uninventoried baseline member')
    models=[toon.loads(member('brands/onexplayer/models/'+name+'.toon').read_text(encoding='utf-8'),strict=True) for name in ('onexplayer-3','x2-mini')]
    if models[0]['resources']!=models[1]['resources']:raise ValueError('Models do not share resources')
    for model,values in zip(models,((472,1100),(475,700))):
        if (model['hdr']['full_frame'],model['hdr']['peak'])!=values:raise ValueError('HDR mapping differs')
        if model['hardware_matching']['mode']!='advisory-exact-dmi-v1':raise ValueError('Model name must remain advisory')
    owned={'.gitignore','LICENSE','README.md','THIRD_PARTY_NOTICES.md','repository.toon',
        'locks/public-baseline.toon','locks/toon-parser.toon','tools/check.py',
        'tools/materialize_baseline.py','tests/test_standalone.py',
        'brands/onexplayer/models/onexplayer-3.toon','brands/onexplayer/models/x2-mini.toon'}
    parser_lock=toon.loads(member('locks/toon-parser.toon').read_text(encoding='utf-8'),strict=True)
    extra=set()
    import_locks={'locks/additional-sources.toon','locks/rapl-sources.toon','locks/base-resource-sources.toon','locks/installer-e18/archive-inventory.toon'}
    for name in sorted(import_locks):
        imported=toon.loads(member(name).read_text(encoding='utf-8'),strict=True)
        for row in imported['files']:
            if row['path'] in names|owned|extra:raise ValueError('Imported source collision')
            extra.add(row['path']);raw=member(row['path']).read_bytes()
            if len(raw)!=row['size'] or sha(raw)!=row['sha256']:raise ValueError('Imported source differs')
    allowed=names|owned|extra|import_locks|{'vendor/'+r['path'] for r in parser_lock['files']}
    actual=set()
    for path in ROOT.rglob('*'):
        relative=path.relative_to(ROOT)
        if '.git' in relative.parts or '__pycache__' in relative.parts:continue
        if path.is_symlink() or getattr(path,'is_junction',lambda:False)():raise ValueError('Linked source member')
        if path.is_file():actual.add(relative.as_posix())
    if actual!=allowed:raise ValueError('Source export differs from explicit whitelist: '+repr(sorted(actual^allowed)))
    print('Standalone source snapshot verified:',len(names),'baseline files and two shared-resource model sources; use the exact pinned SDK to compile the resource pool.')

if __name__=='__main__':check()
